# Lokal panel yalnızca bu adrese bağlanır. Değiştirmeyin.
LOCAL_HOST=127.0.0.1
LOCAL_PORT=4310

# İlk geliştirme için 0 yapıp mevcut Yedigül API'sini lokalde çalıştırabilirsiniz.
# Canlı kullanımda 1 olmalı; panel SSH tünelini kendisi açar.
SSH_ENABLED=1
SSH_HOST=sunucu-adresi
SSH_PORT=22
SSH_USER=yedigul-admin
SSH_KEY_PATH=C:\\Users\\kullanici\\.ssh\\yedigul_admin
SSH_KNOWN_HOSTS_PATH=C:\\Users\\kullanici\\.ssh\\known_hosts
LOCAL_TUNNEL_PORT=43002
REMOTE_ADMIN_HOST=127.0.0.1
REMOTE_ADMIN_PORT=3002

# Her iki modda da yalnızca loopback adresine izin verilir.
REMOTE_ADMIN_BASE_URL=http://127.0.0.1:43002
REMOTE_AUTH_PATH=/api/auth
REMOTE_ADMIN_PATH=/api/admin

# Menü ve yüklenen görselleri yeni sekmede açmak için kullanılır.
PUBLIC_MENU_URL=https://www.yedigulrestorant.com/menu/


# ---- Pano ----
# Site sagligi konektoru bu adresi ve ayni koken altindaki /api/health'i yoklar.
PUBLIC_SITE_URL=https://www.yedigulrestorant.com/
# Konektor onbellegi ve gunluk anlik goruntuler. Repo disinda tutulur.
PANO_DB_PATH=C:\Users\kullanici\Desktop\Projeler\YediguladminDatabase\pano.db

# Asagidakiler bos birakilirsa ilgili panel "bagli degil" gorunur, pano calisir.
IG_USER_ID=
IG_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
PLACES_API_KEY=
PLACES_PLACE_ID=
